+/*
+ * Validate the TLS Server Name Indication.
+ *
+ * SNI is the hostname sent by the client in the TLS handshake. This checks
+ * that it matches the hostname configured for this server.
+ */
+static int validate_sni(SSL *ssl, int *al, void *arg)
+{
+    const char *expected_name = arg;
+    const char *received_name;
+
+    received_name = SSL_get_servername(ssl, TLSEXT_NAMETYPE_host_name);
+
+    if (received_name == NULL ||
+        expected_name == NULL ||
+        strcasecmp(received_name, expected_name) != 0) {
+        fprintf(stderr, "invalid SNI: received '%s', expected '%s'\n",
+                received_name != NULL ? received_name : "(none)",
+                expected_name != NULL ? expected_name : "(none)");
+
+        /*
+         * Send an unrecognized_name TLS alert to the client.
+         */
+        if (al != NULL)
+            *al = SSL_AD_UNRECOGNIZED_NAME;
+
+        return SSL_TLSEXT_ERR_ALERT_FATAL;
+        }
+
+    fprintf(stderr, "accepted SNI: %s\n", received_name);
+    return SSL_TLSEXT_ERR_OK;
+}
