+static int require_sni(SSL *ssl, int *al, void *arg)
+{
+    const unsigned char *ext_data = NULL;
+    size_t ext_len = 0;
+
+    /*
+     * Check whether the ClientHello contained the server_name extension.
+     */
+    if (!SSL_client_hello_get0_ext(ssl,
+                                   TLSEXT_TYPE_server_name,
+                                   &ext_data,
+                                   &ext_len)) {
+        fprintf(stderr, "ClientHello has no SNI\n");
+
+        if (al != NULL)
+            *al = SSL_AD_UNRECOGNIZED_NAME;
+
+        return 0; /* abort ClientHello processing */
+        }
+
+    return 1;
+}
+
+static int validate_sni(SSL *ssl, int *al, void *arg)
+{
+    const char *expected = arg;
+    const char *received;
+
+    received = SSL_get_servername(ssl, TLSEXT_NAMETYPE_host_name);
+
+    fprintf(stderr, "SNI received: %s\n",
+            received != NULL ? received : "(none)");
+
+    if (received == NULL ||
+        expected == NULL ||
+        strcasecmp(received, expected) != 0) {
+        fprintf(stderr, "invalid SNI: received '%s', expected '%s'\n",
+                received != NULL ? received : "(none)",
+                expected != NULL ? expected : "(none)");
+
+        if (al != NULL)
+            *al = SSL_AD_UNRECOGNIZED_NAME;
+
+        return SSL_TLSEXT_ERR_ALERT_FATAL;
+        }
+
+    return SSL_TLSEXT_ERR_OK;
+}
+
