FROM rub-nds/quic/alpine-build:3.19 AS boringssl

ARG VERSION_BORINGSSL

# Build boringssl first, so it can be reused for several xquic versions
RUN git clone --depth=1 --branch=${VERSION_BORINGSSL} https://github.com/google/boringssl.git /boringssl
WORKDIR /boringssl
RUN cmake -B build -DCMAKE_POSITION_INDEPENDENT_CODE=ON
RUN make -C build -j$(nproc) ssl crypto

FROM boringssl AS xquic-base

ARG VERSION_XQUIC

# Build xquic (only the demo programs)
RUN git clone --depth=1 --branch=v${VERSION_XQUIC} https://github.com/alibaba/xquic /xquic
WORKDIR /xquic/build/
RUN cmake -DCMAKE_BUILD_TYPE=Debug -DXQC_ENABLE_TESTING=1 -DXQC_SUPPORT_SENDMMSG_BUILD=1 -DXQC_ENABLE_EVENT_LOG=1 -DXQC_ENABLE_BBR2=1 -DXQC_ENABLE_RENO=1 -DSSL_TYPE=boringssl -DSSL_PATH=/boringssl ..
RUN make -j$(nproc) demo_server demo_client

# Add a self-signed certificate for the server
WORKDIR /xquic/build/demo/
RUN openssl req -newkey rsa:2048 -nodes -keyout server.key -x509 -days 3650 -out server.crt -subj "/CN=localhost"

FROM xquic-base AS xquic-server
ENV QUIC_CMD="./demo_server"
ENV CONTROL_MODE="server"
ENTRYPOINT ["python3", "/control_server.py"]

FROM xquic-base AS xquic-client
ENV QUIC_CMD="./demo_client"
ENV CONTROL_MODE="client"
ENTRYPOINT ["python3", "/control_server.py"]
