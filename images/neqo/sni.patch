+    fn observe_client_hello(&mut self, d: &[u8]) -> Res<()> {
+        const MAX_BUF: usize = 16 * 1024;
+        const ALERT_UNRECOGNIZED_NAME: u8 = 112;
+        const ALLOWED_SNI: &str = "server.example.org";
+
+        if self.sni_done {
+            return Ok(());
+        }
+        if self.sni_buf.len() + d.len() > MAX_BUF {
+            self.sni_done = true;
+            self.sni_buf = Vec::new();
+            return Ok(());
+        }
+        self.sni_buf.extend_from_slice(d);
+
+        if let Some(range) = find_sni(&self.sni_buf) {
+            let sni: Option<String> = std::str::from_utf8(&self.sni_buf[range])
+                .ok()
+                .map(str::to_owned);
+            self.sni_done = true;
+            self.sni_buf = Vec::new();
+            if sni.as_deref() == Some(ALLOWED_SNI) {
+                qinfo!("SNI CHECK: {ALLOWED_SNI} sent, accepting");
+                return Ok(());
+            }
+            qinfo!("SNI CHECK: wrong SNI {sni:?}, sending alert {ALERT_UNRECOGNIZED_NAME}");
+            return Err(Error::CryptoAlert(ALERT_UNRECOGNIZED_NAME));
+        }
+
+        if self.sni_buf.len() >= 4 {
+            let b = &self.sni_buf;
+            let msg_len = (usize::from(b[1]) << 16) | (usize::from(b[2]) << 8) | usize::from(b[3]);
+            if b.len() >= 4 + msg_len {
+                // Whole ClientHello received and it has no SNI.
+                self.sni_done = true;
+                self.sni_buf = Vec::new();
+                qinfo!("SNI CHECK: no SNI, sending alert {ALERT_UNRECOGNIZED_NAME}");
+                return Err(Error::CryptoAlert(ALERT_UNRECOGNIZED_NAME));
+            }
+        }
+        Ok(())
+    }
+
